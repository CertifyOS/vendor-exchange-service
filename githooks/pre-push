#!/bin/sh
#
# Pre-push hook to run comprehensive checks before pushing
echo "Running pre-push checks..."

# Format checking
echo "Spotless executing: checking codebase formatting..."
make format-check
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ Spotless violations found. Push aborted."
  exit 1
fi

# Linting
echo "Checkstyle executing: linting codebase..."
make lint
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ Checkstyle violations found. Push aborted."
  exit 1
fi

# Static Analysis
echo "SpotBugs executing: running static analysis..."
make static-analysis
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ Static analysis violations found. Push aborted."
  exit 1
fi

# Unit Tests
echo "Executing unit tests..."
make test
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ Unit tests failed. Push aborted."
  exit 1
fi

# Integration Tests
echo "Executing integration tests..."
make integration-test
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ Integration tests failed. Push aborted."
  exit 1
fi

# Coverage Report
echo "Generating coverage report..."
make coverage
RESULT=$?
if [ $RESULT -ne 0 ]; then
  echo "❌ Coverage report generation failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed, proceeding with push"
exit 0

