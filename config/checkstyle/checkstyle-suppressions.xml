<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Test and integration-test sources -->
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" checks="Javadoc*" />
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" checks="VariableDeclarationUsageDistance" />
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" checks="VisibilityModifier" />
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" checks="AvoidStaticImport" />
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" checks="HideUtilityClassConstructor" />
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" id="BanSystemOut" />
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" id="BanSystemErr" />

    <!-- File length: 500 for main, 1,000 for tests. Each FileLength module applies to one side only. -->
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" id="FileLengthMain" />
    <suppress files="[/\\]src[/\\]main[/\\]java[/\\]" id="FileLengthTest" />

    <!-- Ticket keys: banned in main; in tests only inside an @Disabled reason, which DisabledNeedsTicket requires. -->
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]java[/\\]" id="BanTicketKeys" />
    <suppress files="[/\\]src[/\\]main[/\\]java[/\\]" id="DisabledNeedsTicket" />

    <!-- Test resources -->
    <suppress files="[/\\]src[/\\](test|integrationTest)[/\\]resources.*" checks="." />

    <!-- JavadocStyle enforces package-level Javadoc in package-info.java; not wanted. -->
    <suppress files="package-info.java" checks="JavadocStyle" />

    <!-- non-code files -->
    <suppress files="\.(bdr|eot|gif|gzip|jar|json|otf|png|svg|ttf|woff|zip)$" checks="FileTabCharacter" />
    <suppress files="\.(bdr|eot|gif|gzip|jar|json|otf|png|svg|ttf|woff|zip)$" checks="NewlineAtEndOfFile" />

    <!-- Generated code is not subject to checkstyle. -->
    <suppress files="[/\\].*[/\\]generated.*[/\\]" checks="." />
</suppressions>
