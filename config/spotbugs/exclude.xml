<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclusions for com.certifyos.vendor_exchange.

    One policy exclusion, taken from the new-service playbook: the expose-internal-representation
    rules are disabled once here rather than suppressed class by class (api-layer carries 614
    @SuppressFBWarnings for them). Records and DTOs here hold immutable Lists and Maps by convention
    (List.copyOf / Map.copyOf in compact constructors), which these two rules cannot see.

    Every other exclusion must name one class and one pattern and say why the finding is wrong there.
-->
<FindBugsFilter>
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>
</FindBugsFilter>
