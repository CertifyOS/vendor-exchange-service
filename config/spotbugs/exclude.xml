<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        We exclude EI_EXPOSE_REP2 warnings for our CDI beans because:
        1. They are managed by the container
        2. They are stateless by design
        3. The dependencies are final and immutable
        4. The implementations are using pure operations
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="com.certifyos.dal.user.service.UserService"/>
            <Class name="com.certifyos.dal.user.resource.UserResource"/>
        </Or>
